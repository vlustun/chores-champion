# Copy to .env.docker and run:  docker compose --env-file .env.docker up -d --build
# Generate a secret with: openssl rand -hex 32
APP_ENV=prod
APP_SECRET=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=chores
MYSQL_USER=chores
MYSQL_PASSWORD=change-me
WEB_PORT=8080
# Mail: real SMTP DSN in production, e.g. smtp://user:pass@smtp.example.com:587
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@example.com
# Host user for the dev container (bash does not export UID by default)
UID=1000
GID=1000
