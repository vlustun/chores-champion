<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Chores Champion{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏆</text></svg>">
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body
    data-controller="timezone"
    data-timezone-stored-value="{{ app.user ? app.user.timezone : '' }}"
    data-timezone-url-value="{{ app.user ? path('app_profile_timezone') : '' }}"
    data-timezone-token-value="{{ app.user ? csrf_token('detect_timezone') : '' }}"
    data-timezone-manual-value="{{ app.user and app.user.timezoneManual ? 'true' : 'false' }}">
<header class="top">
    <a class="brand" href="{{ path('app_home') }}">🏆 Chores Champion</a>
    {% if app.user %}
    <nav>
        <a href="{{ path('app_tasks') }}">Tasks</a>
        <a href="{{ path('app_my_tasks') }}">My tasks</a>
        <a href="{{ path('app_week') }}">This week</a>
        <a href="{{ path('app_profile') }}">Profile</a>
        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Admin</a>{% endif %}
        <a href="{{ path('app_logout') }}">Log out</a>
    </nav>
    {% endif %}
</header>
<main>
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="flash flash-{{ type }}" role="status">{{ message }}</div>{% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
