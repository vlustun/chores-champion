{% extends 'base.html.twig' %}
{% block title %}Log in · Chores Champion{% endblock %}
{% block body %}
<section class="card narrow">
    <h1>Log in</h1>
    {% if error %}<div class="flash flash-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post">
        <label>Email <input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus></label>
        <label>Password <input type="password" name="_password" autocomplete="current-password" required></label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Log in</button>
    </form>
    <p class="meta"><a href="{{ path('app_forgot_password') }}">Forgot your password?</a></p>
</section>
{% endblock %}
